# Reply.BD storefront template — local dev environment
# Copy to .env.local and adjust for your setup.

# Reply.BD API base (no trailing slash)
NEXT_PUBLIC_API_BASE=http://myapp.test

# Tenant slug to develop against
NEXT_PUBLIC_STOREFRONT_SLUG=admin

# ISR webhook secret — must match the user's `revalidate_secret` in Laravel
REVALIDATE_SECRET=local-dev-secret
