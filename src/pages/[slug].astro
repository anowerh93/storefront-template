---
/**
 * Ad funnel landing page at the clean root URL: /{slug}
 *
 * Funnels used to live at /f/{slug}; they now resolve at the root so a
 * customer's ad URL reads as site.com/{slug}. SSR on CF Workers
 * (prerender:false) — resolved per request by slug, same pattern as the
 * product page. Always noindex so it never competes with the catalog product
 * page in search.
 *
 * Astro serves its static/named routes (about, cart, /products/…, sitemap.xml)
 * with PRIORITY over this dynamic [slug] route, and the dashboard refuses to
 * mint a funnel slug that collides with a reserved root path
 * (Funnel::RESERVED_SLUGS), so this route only ever catches genuine funnel
 * slugs — or the old link of a landing page whose owner changed its link
 * (forwarded below). Anything else is a real 404.
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import { ApiError, getFunnel, getStorefrontGated, type StorefrontGate } from '../lib/api';
import { FunnelPage } from '../views/funnel';
import { visitorCountry } from '../lib/geo';
import type { FunnelPayload } from '../lib/types';

const slug = Astro.params.slug as string;
// Opens the প্রবাসী WhatsApp field for a visitor abroad. Per request: this
// page's HTML must never be cached across visitors (see src/lib/geo.ts).
const country = visitorCountry(Astro.request);

// A landing page's owner may change its link; the API's 404 for the old link
// then carries the forward (no second request: a separate redirect lookup per
// root miss would spend a throttled endpoint on every scanner probe).
let forward: { to: string; status: number } | undefined;

// Parallel fetches — sequential awaits cost an extra origin round-trip.
// Each fails soft on its own: getFunnel 402s on the same plan gate, and
// its rejection must not discard the gate verdict.
const [funnel, gate]: [FunnelPayload | null, StorefrontGate] = await Promise.all([
  slug
    ? getFunnel(slug).catch((err) => {
        if (err instanceof ApiError && err.status === 404) {
          forward = err.redirect;
        } else {
          console.warn(`[[slug].astro] getFunnel(${slug}) failed:`, err);
        }
        return null;
      })
    : Promise.resolve(null),
  getStorefrontGated(),
]);
const meta = gate.meta;

// Follow the forward: local paths only, never "//host" or "/\host" (a
// poisoned to_path must not become an open redirect), never back to itself.
// The ad's query string (utm_*, fbclid: the pixel and attribution need them)
// goes along. A link change forwards with a 302 (browsers keep a 301 for
// good); a redirect the owner added by hand keeps its own status. Skipped on
// a closed shop: the honest render there is Base's ShopClosed. The API strips
// a query from every stored path; should one ever carry its own, the ad's
// query is appended with "&", never a second "?".
const to = forward?.to;
if (!funnel && !gate.closed && to && /^\/(?![/\\])/.test(to) && to !== `/${slug}`) {
  const query = Astro.url.search.slice(1);
  const target = query ? `${to}${to.includes('?') ? '&' : '?'}${query}` : to;
  return Astro.redirect(target, forward?.status === 301 ? 301 : 302);
}

// Closed shop: the missing funnel is the plan gate 402ing — an ad click
// still deserves the honest ShopClosed render (Base), not a bare 404.
if (!funnel && !gate.closed) { Astro.response.status = 404; }
---

<Base title={funnel?.name ?? 'Not found'} description={funnel?.config?.hero?.subheadline} noindex={true} gate={gate} bengaliFont={funnel?.config?.font === 'bengali'}>
  <FunnelPage client:load funnel={funnel} meta={meta} visitorCountry={country} />
</Base>
