---
/**
 * Customer registration page. OPT-IN — guest checkout/tracking unaffected.
 * SSR + noindex (account pages shouldn't appear in search).
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getStorefrontGated } from '../lib/api';
import { RegisterPage } from '../views/register';

// Gated: a plan-gated tenant (402) renders Base's ShopClosed, not the form.
const gate = await getStorefrontGated();
const meta = gate.meta;
---

<Base title="Create an account" gate={gate} noindex={true}>
  <RegisterPage client:load meta={meta} />
</Base>
