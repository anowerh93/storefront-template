---
/**
 * Cart page (Phase 2 multi-product cart). The cart itself lives in the
 * browser's localStorage — this route only fetches the storefront meta for the
 * chrome (header/footer/branding); CartPage reads the lines client-side.
 *
 * SSR on CF Workers (prerender:false) + noindex — it's a per-visitor page with
 * nothing to crawl.
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import type { Category } from '../lib/types';
import { getCategories, getStorefrontGated } from '../lib/api';
import { CartPage } from '../views/cart';

// Gated: a plan-gated tenant (402) renders Base's ShopClosed, not the cart.
// The header's category menus (the search box's "All Categories" and
// "Browse All Categories") need the list on every page, not only the
// catalogue's. Fetched in parallel; a failure is an empty menu, never the page.
const [gate, categories] = await Promise.all([
  getStorefrontGated(),
  getCategories().catch((): Category[] => []),
]);
const meta = gate.meta;
---

<Base title="Your Cart" description="Review your cart" gate={gate} noindex={true}>
  <CartPage categories={categories} client:load meta={meta} />
</Base>
