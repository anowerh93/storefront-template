---
/**
 * Cart page (Phase 2 multi-product cart). The cart itself lives in the
 * browser's localStorage — this route only fetches the storefront meta for the
 * chrome (header/footer/branding); CartPage reads the lines client-side.
 *
 * SSR on CF Workers (prerender:false) + noindex — it's a per-visitor page with
 * nothing to crawl.
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getStorefrontGated } from '../lib/api';
import { CartPage } from '../views/cart';

// Gated: a plan-gated tenant (402) renders Base's ShopClosed, not the cart.
const gate = await getStorefrontGated();
const meta = gate.meta;
---

<Base title="Your Cart" description="Review your cart" gate={gate} noindex={true}>
  <CartPage client:load meta={meta} />
</Base>
