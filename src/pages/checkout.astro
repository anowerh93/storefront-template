---
/**
 * Dedicated checkout page. Reached from the PDP "Order Now" button:
 *   /checkout?p=<product-slug>&v=<variant-index>&q=<qty>
 *
 * SSR on CF Workers (prerender:false) — the product comes from a query
 * param, not a build-time route, so we fetch it server-side per request
 * (same pattern as the product + order pages). The CheckoutPage island
 * then reuses the exact order schema + submitOrder logic.
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getProduct, getStorefront } from '../lib/api';
import { CheckoutPage } from '../views/checkout';
import type { ProductDetail, StorefrontMeta } from '../lib/types';

const params = Astro.url.searchParams;
const slug = params.get('p') ?? '';
// `?p=` present = an express "buy now" attempt. We pass this intent through so
// the checkout island can show "Nothing to check out" if the express product
// fetch failed, instead of silently dropping the shopper into cart mode (which
// would show / place THEIR persisted cart for a buy-now click).
const expressAttempt = slug !== '';
const vRaw = parseInt(params.get('v') ?? '', 10);
const variantIndex = Number.isNaN(vRaw) ? null : vRaw;
const qty = Math.max(1, parseInt(params.get('q') ?? '1', 10) || 1);

// Parallel fetches — sequential awaits cost an extra origin round-trip.
const [product, meta]: [ProductDetail | null, StorefrontMeta | null] = await Promise.all([
  slug
    ? getProduct(slug).catch((err) => {
        console.warn(`[checkout.astro] getProduct(${slug}) failed:`, err);
        return null;
      })
    : Promise.resolve(null),
  getStorefront().catch((err) => {
    console.warn('[checkout.astro] getStorefront() failed:', err);
    return null;
  }),
]);
---

{/* noindex like cart/account: thin utility shell, reachable from every PDP */}
<Base title="Checkout" description="Secure checkout" noindex={true} meta={meta}>
  <CheckoutPage client:load product={product} meta={meta} variantIndex={variantIndex} qty={qty} expressAttempt={expressAttempt} />
</Base>
