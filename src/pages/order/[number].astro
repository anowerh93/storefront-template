---
/**
 * Order success / tracking page — the route that was MISSING (the live bug).
 *
 * Reached two ways:
 *   1. Right after checkout, the order forms redirect to
 *      /order/{number}?placed=1&phone={last4} → the "Order placed!" success
 *      screen + status timeline.
 *   2. Guest tracking from the lookup form: /order/{number}?phone={last4}.
 *
 * SSR on CF Workers (prerender:false) — the order number is a per-request
 * route param, not a build-time path, and the lookup is per-customer live
 * data. We fetch only the storefront meta here (for the chrome); the order
 * itself is looked up CLIENT-SIDE inside OrderStatusPage so we can show a
 * loading state and dodge the "placed but lookup races" window right after
 * submit (same reasoning documented in order-status.tsx).
 */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getStorefrontGated } from '../../lib/api';
import { OrderStatusPage } from '../../views/order-status';

// A push-IPN gateway (SSLCommerz) sends the shopper back here with a
// cross-site FORM POST (see `security.checkOrigin` in astro.config.mjs).
// Nothing in that body is read — the payment is confirmed server-to-server
// and the page looks the order up itself — so answer with a 303 to the same
// URL: the browser re-requests it as a plain GET, the page behaves exactly as
// on any other return, and a refresh never asks to "resubmit the form".
// Same path + query, so there is nowhere else this can lead.
if (Astro.request.method !== 'GET' && Astro.request.method !== 'HEAD') {
  // Discard the body without buffering it (it is the gateway's own copy of
  // the transaction, of no use here) so the connection is left clean.
  try {
    await Astro.request.body?.pipeTo(new WritableStream());
  } catch {
    /* already consumed / aborted — nothing to discard */
  }
  return Astro.redirect(Astro.url.pathname + Astro.url.search, 303);
}

const orderNumber = Astro.params.number ?? '';
const phone = Astro.url.searchParams.get('phone') ?? undefined;
const placed = Astro.url.searchParams.get('placed') === '1';
// Set when checkout's "Create an account?" hit a phone that already has one
// (the order still succeeded) — the success screen nudges them to log in.
const accountExists = Astro.url.searchParams.get('account_exists') === '1';

// Gated: a plan-gated tenant (402) renders Base's ShopClosed — the order
// lookup API is behind the same gate, so the timeline couldn't load anyway.
const gate = await getStorefrontGated();
const meta = gate.meta;
---

<Base title={`Order #${orderNumber}`} gate={gate} noindex={true}>
  <OrderStatusPage
    client:load
    orderNumber={orderNumber}
    phone={phone}
    placed={placed}
    accountExists={accountExists}
    meta={meta}
  />
</Base>
