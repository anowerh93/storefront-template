---
/**
 * Order lookup landing page — shown when the customer clicks "Track order"
 * in the header/footer without already having an order number in hand.
 */
import Base from '../../layouts/Base.astro';
import type { Category } from '../../lib/types';
import { getCategories, getStorefrontGated } from '../../lib/api';
import { OrderLookupPage } from '../../views/order-lookup';

// Gated: a plan-gated tenant (402) renders Base's ShopClosed, not the form.
// The header's category menus (the search box's "All Categories" and
// "Browse All Categories") need the list on every page, not only the
// catalogue's. Fetched in parallel; a failure is an empty menu, never the page.
const [gate, categories] = await Promise.all([
  getStorefrontGated(),
  getCategories().catch((): Category[] => []),
]);
const meta = gate.meta;
---

<Base title="Track your order" gate={gate}>
  <OrderLookupPage categories={categories} client:load meta={meta} />
</Base>
