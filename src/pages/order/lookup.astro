---
/**
 * Order lookup landing page — shown when the customer clicks "Track order"
 * in the header/footer without already having an order number in hand.
 */
import Base from '../../layouts/Base.astro';
import { getStorefrontGated } from '../../lib/api';
import { OrderLookupPage } from '../../views/order-lookup';

// Gated: a plan-gated tenant (402) renders Base's ShopClosed, not the form.
const gate = await getStorefrontGated();
const meta = gate.meta;
---

<Base title="Track your order" gate={gate}>
  <OrderLookupPage client:load meta={meta} />
</Base>
