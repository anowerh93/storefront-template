---
/**
 * Blog listing (/blog). SSR — posts change without a rebuild, and ?page is
 * read off the URL. Shared by both business types. Hydrated so the e-commerce
 * Header (mobile menu / category dropdown) stays interactive.
 */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getBlogPosts, getStorefrontGated, getCategories, type StorefrontGate } from '../../lib/api';
import { blogSchema, breadcrumbSchema } from '../../lib/schema';
import { BlogListPage } from '../../views/blog-list';
import type { BlogPostCard, Category, Paginated } from '../../lib/types';

const page = parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const search = (Astro.url.searchParams.get('search') ?? '').trim();

// Each fetch fails soft on its own — the posts call 402s on the same plan
// gate, and its rejection must not discard the gate verdict.
const [posts, gate, categories]: [Paginated<BlogPostCard> | null, StorefrontGate, Category[]] = await Promise.all([
  getBlogPosts({ page, perPage: 12, search: search || undefined }).catch((err) => { console.warn('[blog/index] getBlogPosts failed:', err); return null; }),
  getStorefrontGated(),
  getCategories().catch(() => []),
]);
const meta = gate.meta;

const origin = (meta?.public_url ?? Astro.url.origin).replace(/\/+$/, '');
const schemas = meta
  ? [
      blogSchema(meta, `${origin}/blog`),
      breadcrumbSchema([{ name: 'Home', url: `${origin}/` }, { name: 'Blog' }]),
    ].filter((s): s is Record<string, unknown> => s !== null)
  : [];
---

<Base title="Blog" description={meta?.seo?.description ?? meta?.about ?? undefined} schema={schemas} gate={gate}>
  <BlogListPage client:load meta={meta} posts={posts} categories={categories} search={search} />
</Base>
