---
/**
 * Default info page (/pages/[slug]) — Terms / Privacy / Refund / Careers.
 * SSR — fetched per request, CDN-cached. The slug set is fixed (no renames),
 * so an unknown OR disabled page is a REAL 404 (no redirect-table lookup).
 * Shared by both business types.
 */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getInfoPage, getStorefrontGated, getCategories, type StorefrontGate } from '../../lib/api';
import { breadcrumbSchema } from '../../lib/schema';
import { InfoPageView } from '../../views/info-page';
import type { InfoPageDetail, Category } from '../../lib/types';

const slug = Astro.params.slug as string;

// Each fetch fails soft on its own — the page call 402s on the same plan
// gate, and its rejection must not discard the gate verdict.
const [page, gate, categories]: [InfoPageDetail | null, StorefrontGate, Category[]] = await Promise.all([
  getInfoPage(slug).catch((err) => { console.warn(`[pages/[slug]] getInfoPage(${slug}) failed:`, err); return null; }),
  getStorefrontGated(),
  getCategories().catch(() => []),
]);
const meta = gate.meta;

// Closed shop: the missing page is the plan gate 402ing — the honest render
// is Base's ShopClosed (200 + noindex), not a 404.
if (!page && !gate.closed) {
  Astro.response.status = 404;
}

const origin = (meta?.public_url ?? Astro.url.origin).replace(/\/+$/, '');
const schemas = page && meta
  ? [
      breadcrumbSchema([
        { name: 'Home', url: `${origin}/` },
        { name: page.title },
      ]),
    ].filter((s): s is Record<string, unknown> => s !== null)
  : [];
---

<Base
  title={page?.seo?.title}
  description={page?.seo?.description ?? undefined}
  noindex={page?.seo?.noindex}
  schema={schemas}
  gate={gate}
>
  <InfoPageView client:load meta={meta} page={page} categories={categories} />
</Base>
