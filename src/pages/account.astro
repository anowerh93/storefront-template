---
/**
 * Customer account page — order history + "track without typing". The view
 * redirects to /login client-side when there's no stored token. SSR + noindex
 * (per-customer page; never cached or indexed).
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import type { Category } from '../lib/types';
import { getCategories, getStorefrontGated } from '../lib/api';
import { AccountPage } from '../views/account';

// Gated: a plan-gated tenant (402) renders Base's ShopClosed, not the account.
// The header's category menus (the search box's "All Categories" and
// "Browse All Categories") need the list on every page, not only the
// catalogue's. Fetched in parallel; a failure is an empty menu, never the page.
const [gate, categories] = await Promise.all([
  getStorefrontGated(),
  getCategories().catch((): Category[] => []),
]);
const meta = gate.meta;
---

<Base title="My account" gate={gate} noindex={true}>
  <AccountPage categories={categories} client:load meta={meta} />
</Base>
