---
/**
 * Customer account page — order history + "track without typing". The view
 * redirects to /login client-side when there's no stored token. SSR + noindex
 * (per-customer page; never cached or indexed).
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getStorefrontGated } from '../lib/api';
import { AccountPage } from '../views/account';

// Gated: a plan-gated tenant (402) renders Base's ShopClosed, not the account.
const gate = await getStorefrontGated();
const meta = gate.meta;
---

<Base title="My account" gate={gate} noindex={true}>
  <AccountPage client:load meta={meta} />
</Base>
