---
/**
 * Contact page (header/footer "Contact" link). Renders the tenant's contact
 * details + a message form that emails the shop owner
 * (POST /storefronts/{slug}/contact). Prerendered to static HTML like About —
 * the form island hydrates client-side and the Turnstile site key is baked
 * from the meta payload at build time. Indexable (a real contact surface).
 */
import Base from '../layouts/Base.astro';
import type { Category } from '../lib/types';
import { getCategories, getStorefrontGated } from '../lib/api';
import { breadcrumbSchema } from '../lib/schema';
import { ContactPage } from '../views/contact';

// Gated: a plan-gated tenant (402) bakes Base's ShopClosed at build time.
// The header's category menus (the search box's "All Categories" and
// "Browse All Categories") need the list on every page, not only the
// catalogue's. Fetched in parallel; a failure is an empty menu, never the page.
const [gate, categories] = await Promise.all([
  getStorefrontGated(),
  getCategories().catch((): Category[] => []),
]);
const meta = gate.meta;

// Prerendered page — breadcrumb only once a public origin exists.
const origin = (meta?.public_url ?? '').replace(/\/+$/, '');
const schemas = origin
  ? [breadcrumbSchema([{ name: 'Home', url: `${origin}/` }, { name: 'Contact' }])]
  : [];
---

<Base title={meta ? `Contact ${meta.name}` : 'Contact'} gate={gate} schema={schemas}>
  <ContactPage categories={categories} meta={meta} client:load />
</Base>
