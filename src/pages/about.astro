---
/**
 * About page (footer "About" link). Pure content — prerendered to static
 * HTML at build time. Renders the tenant's `about` text from storefront meta.
 */
import Base from '../layouts/Base.astro';
import { getStorefront, getTeam } from '../lib/api';
import { breadcrumbSchema } from '../lib/schema';
import { AboutPage } from '../views/about';
import { ServiceAboutPage } from '../views/service-about';
import type { StorefrontMeta, TeamMember } from '../lib/types';

let meta: StorefrontMeta | null = null;
try {
  meta = await getStorefront();
} catch (err) {
  console.warn('[about.astro] getStorefront() failed:', err);
}

// Service tenants get a service-appropriate About (built from the
// service_home.about block) instead of the e-commerce product about article.
const isService = meta?.business_type === 'service' && !!meta?.service_home;

// The e-commerce About page renders a "Meet Our Team" section from the same
// team-members API service tenants use. Best-effort — never blocks the page.
let team: TeamMember[] = [];
if (meta && !isService) {
  try {
    team = await getTeam();
  } catch (err) {
    console.warn('[about.astro] getTeam() failed:', err);
  }
}
const aboutTitle = isService
  ? (meta!.service_home!.about?.title?.replace(/<[^>]*>/g, '') || `About ${meta!.name}`)
  : (meta?.about_title || 'About');

// Prerendered page — breadcrumb only once a public origin exists.
const origin = (meta?.public_url ?? '').replace(/\/+$/, '');
const schemas = origin
  ? [breadcrumbSchema([{ name: 'Home', url: `${origin}/` }, { name: 'About' }])]
  : [];
---

<Base title={aboutTitle} schema={schemas} meta={meta}>
  {isService ? <ServiceAboutPage meta={meta} /> : <AboutPage meta={meta} team={team} />}
</Base>
