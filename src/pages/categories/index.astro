---
/**
 * Category index (footer/header "Categories" link). The category list is
 * fetched per-tenant at build; a content change triggers a full rebuild
 * (RevalidateStorefrontJob). The view MUST hydrate (client:load): the list
 * itself is static, but the shared <Header> inside it carries the mobile
 * hamburger / search / cart badge — without hydration they render but do
 * nothing (that bug shipped once on this exact page).
 */
import Base from '../../layouts/Base.astro';
import { getStorefront, getCategories } from '../../lib/api';
import { CategoryListPage } from '../../views/category-list';
import type { StorefrontMeta, Category } from '../../lib/types';

let meta: StorefrontMeta | null = null;
let categories: Category[] = [];

try {
  [meta, categories] = await Promise.all([
    getStorefront(),
    getCategories().catch(() => []),
  ]);
} catch (err) {
  console.warn('[categories/index.astro] fetch failed:', err);
}
---

<Base title="Categories" meta={meta}>
  <CategoryListPage client:load meta={meta} categories={categories} />
</Base>
