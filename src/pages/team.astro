---
/**
 * Team page (service tenants). SSR — fetched per request and CDN-cached.
 * Service-tenant only BY DESIGN: e-commerce tenants render their team on
 * About and this page is noindexed for them (their sitemap never lists it),
 * as well as when there are no members (avoids a thin/soft page).
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getTeam, getStorefrontGated, type StorefrontGate } from '../lib/api';
import { breadcrumbSchema } from '../lib/schema';
import { TeamPage } from '../views/team-page';
import type { TeamMember } from '../lib/types';

// Both fetches fail soft on their own: getTeam 402s on the same plan gate,
// and its rejection must not discard the gate verdict.
const [team, gate]: [TeamMember[] | null, StorefrontGate] = await Promise.all([
  getTeam().catch((err) => { console.warn('[team] getTeam failed:', err); return null; }),
  getStorefrontGated(),
]);
const meta = gate.meta;

const members = team ?? [];
const origin = (meta?.public_url ?? Astro.url.origin).replace(/\/+$/, '');
const schemas = meta
  ? [breadcrumbSchema([{ name: 'Home', url: `${origin}/` }, { name: 'Team' }])].filter(
      (s): s is Record<string, unknown> => s !== null,
    )
  : [];
---

<Base title="Our team" noindex={members.length === 0 || meta?.business_type !== 'service'} schema={schemas} gate={gate}>
  {/* client:load — the header's mobile menu inside the view needs hydration */}
  <TeamPage client:load team={members} meta={meta} />
</Base>
