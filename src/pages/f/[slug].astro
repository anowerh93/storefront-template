---
/**
 * Legacy funnel URL — funnels now live at the clean root path /{slug}.
 *
 * Permanently redirect /f/{slug} → /{slug} so existing Facebook-ad links (and
 * any older printed/shared URLs) keep working. SSR (prerender:false) so the
 * redirect runs per request and the query string — ?utm_*, fbclid, etc., which
 * the pixel/attribution needs — is carried across unchanged.
 */
export const prerender = false;

const slug = Astro.params.slug as string;

return Astro.redirect(`/${slug}${Astro.url.search}`, 301);
---
