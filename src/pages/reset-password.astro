---
/**
 * Customer password-reset page (forgot → verify, single-page wizard). SSR
 * (prerender:false) so it never caches a stale logged-in/out state, and
 * noindex (account/auth pages shouldn't appear in search).
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getStorefront } from '../lib/api';
import { ResetPasswordPage } from '../views/reset-password';
import type { StorefrontMeta } from '../lib/types';

let meta: StorefrontMeta | null = null;
try {
  meta = await getStorefront();
} catch (err) {
  console.warn('[reset-password.astro] getStorefront() failed:', err);
}
---

<Base title="Reset password" meta={meta} noindex={true}>
  <ResetPasswordPage client:load meta={meta} />
</Base>
