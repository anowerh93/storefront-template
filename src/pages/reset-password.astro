---
/**
 * Customer password-reset page (forgot → verify, single-page wizard). SSR
 * (prerender:false) so it never caches a stale logged-in/out state, and
 * noindex (account/auth pages shouldn't appear in search).
 */
export const prerender = false;

import Base from '../layouts/Base.astro';
import { getStorefrontGated } from '../lib/api';
import { ResetPasswordPage } from '../views/reset-password';

// Gated: a plan-gated tenant (402) renders Base's ShopClosed, not the form.
const gate = await getStorefrontGated();
const meta = gate.meta;
---

<Base title="Reset password" gate={gate} noindex={true}>
  <ResetPasswordPage client:load meta={meta} />
</Base>
