---
/**
 * Service detail page (service tenants). SSR — fetched per request and
 * CDN-cached, like product detail pages. Client island for the booking form.
 */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getService, getStorefrontGated, type StorefrontGate } from '../../lib/api';
import { breadcrumbSchema } from '../../lib/schema';
import { ServiceDetailPage } from '../../views/service-detail-page';
import type { ServiceDetail } from '../../lib/types';

const slug = Astro.params.slug as string;

// Each fetch fails soft on its own — the service call 402s on the same
// plan gate, and its rejection must not discard the gate verdict.
const [service, gate]: [ServiceDetail | null, StorefrontGate] = await Promise.all([
  getService(slug).catch((err) => { console.warn(`[services/[slug]] getService(${slug}) failed:`, err); return null; }),
  getStorefrontGated(),
]);
const meta = gate.meta;

// Real 404 status when the service doesn't exist (avoid soft-404s).
// Closed shop: the missing service is the plan gate 402ing — the honest
// render is Base's ShopClosed (200 + noindex), not a 404.
if (!service && !gate.closed) {
  Astro.response.status = 404;
}

const origin = (meta?.public_url ?? Astro.url.origin).replace(/\/+$/, '');
const schemas = service
  ? [
      breadcrumbSchema([
        { name: 'Home', url: `${origin}/` },
        { name: 'Services', url: `${origin}/services` },
        { name: service.name },
      ]),
    ].filter((s): s is Record<string, unknown> => s !== null)
  : [];
---

<Base
  title={service?.seo?.title}
  description={service?.seo?.description ?? undefined}
  ogImage={service?.image_url ?? undefined}
  noindex={service?.seo?.noindex}
  schema={schemas}
  gate={gate}
>
  <ServiceDetailPage client:load service={service} meta={meta} />
</Base>
