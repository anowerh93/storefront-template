---
/**
 * Product list / search / filter page (footer "Shop" link).
 *
 * SSR on CF Workers (prerender:false) because it reads ?search / ?category
 * / ?page / ?sort off the URL — those can't be baked at build time. The
 * native GET <form> and <a> filter links re-request this route server-side;
 * only the SortDropdown needs client JS, so the view hydrates as an island.
 */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { getStorefrontGated, getProducts, getCategories, type ProductSort } from '../../lib/api';
import { ProductListPage } from '../../views/product-list';
import ShopClosed from '../../components/layout/shop-closed.astro';
import type { Category } from '../../lib/types';

const sp = Astro.url.searchParams;
const search   = sp.get('search')   ?? '';
const category = sp.get('category') ?? '';
const page     = parseInt(sp.get('page') ?? '1', 10);
const sort     = (sp.get('sort') ?? 'newest') as ProductSort;

// Each fetch fails soft on its own so one rejection can't discard the
// others' results — the gate verdict (closed vs unreachable) must survive
// the products call 402ing on the very same plan gate.
const emptyPage = { data: [], meta: { total: 0, last_page: 1, current_page: 1, per_page: 24 } } as any;
const [gate, productsRes, categories] = await Promise.all([
  getStorefrontGated(),
  getProducts({ page, perPage: 24, search, category, sort }).catch((err): typeof emptyPage => {
    console.warn('[products/index.astro] products fetch failed:', err);
    return emptyPage;
  }),
  getCategories().catch(() => [] as Category[]),
]);
const meta = gate.meta;

const searchParams = { search, category, page: String(page), sort };
---

<Base title="All products" meta={meta}>
  {gate.closed ? (
    <ShopClosed />
  ) : (
    <ProductListPage
      client:load
      searchParams={searchParams}
      meta={meta}
      productsRes={productsRes}
      categories={categories}
    />
  )}
</Base>
