---
/**
 * Base layout for every storefront page.
 *
 * Fetches storefront metadata once per build so the brand color, fonts,
 * Meta Pixel script, and SEO tags are baked into every static page. Replaces
 * the Next.js `src/layout.tsx` — the React-based one couldn't port directly
 * because Astro doesn't have the App Router's root-layout pattern.
 *
 * Per-page metadata override: pass `title`, `description`, `ogImage` as
 * props — this layout merges them on top of the storefront defaults.
 */
import '../styles.css';
import { getStorefront } from '../lib/api';
import { brandCssVars } from '../lib/theme';
import type { StorefrontMeta } from '../lib/types';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Funnel/landing pages set this so they don't compete with the catalog in search. */
  noindex?: boolean;
  /** JSON-LD objects (lib/schema.ts builders) rendered as ld+json scripts. */
  schema?: Record<string, unknown>[];
  /**
   * Storefront metadata fetched by the page. Pages that already call
   * getStorefront() MUST pass it through — on SSR routes a second fetch
   * here costs a full extra round-trip to the Laravel origin per page
   * view (this duplicate was the single biggest TTFB cost). Pass `null`
   * to mean "I fetched and it failed" — only `undefined` (prop omitted)
   * falls back to fetching here.
   */
  meta?: StorefrontMeta | null;
}

const { title, description, ogImage, noindex, schema = [] } = Astro.props;

// Tenant metadata: prefer the page's already-fetched copy; fetch only when
// the page didn't pass one (e.g. 404.astro). If the fallback fails (API
// down, slug mis-set), render a graceful skeleton rather than crashing.
let meta: StorefrontMeta | null = null;
if (Astro.props.meta !== undefined) {
  meta = Astro.props.meta;
} else {
  try {
    meta = await getStorefront();
  } catch (err) {
    console.warn('[Base.astro] getStorefront() failed — rendering without tenant chrome:', err);
  }
}

const finalTitle = title
  ? (meta ? `${title} — ${meta.name}` : title)
  : meta?.seo.title ?? meta?.name ?? 'Storefront';

const finalDescription = description
  ?? meta?.seo.description
  ?? meta?.about
  ?? meta?.name
  ?? '';

const finalOgImage = ogImage ?? meta?.seo.og_image ?? null;

const brandStyle = meta ? brandCssVars(meta.theme_color) : '';
const pixelId = meta?.pixel?.id ?? null;
const siteName = meta?.name ?? '';
const favicon = meta?.logo_url ?? null;

// Canonical — always the tenant's PUBLIC origin (custom domain when
// verified), never this request's host, so the pages.dev mirror points
// search engines at the real domain instead of competing with it.
// Pathname only (query stripped); skipped on noindex pages — a canonical
// on a page that says "don't index me" is a mixed signal.
const canonicalBase = (meta?.public_url ?? '').replace(/\/+$/, '');
const canonical =
  canonicalBase && !noindex && !meta?.seo?.discourage
    ? canonicalBase + (Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, ''))
    : null;

// JSON-LD: escape `<` so user-authored content (review bodies, FAQ answers)
// can never break out of the script tag.
const ldJson = schema.map((s) => JSON.stringify(s).replace(/</g, '\\u003c'));
---

<!doctype html>
<html lang="en" class="font-sans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{finalTitle}</title>
    {finalDescription && <meta name="description" content={finalDescription} />}
    {/* noindex: per-page (funnels) OR the tenant's WordPress-style
        "discourage search engines" toggle (build/demo mode). */}
    {(noindex || meta?.seo?.discourage) && <meta name="robots" content="noindex,nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Search-engine ownership verification (Google Search Console / Bing).
        Rendered even in discourage mode — tenants verify BEFORE launch. */}
    {meta?.verification?.google && <meta name="google-site-verification" content={meta.verification.google} />}
    {meta?.verification?.bing && <meta name="msvalidate.01" content={meta.verification.bing} />}

    {/* Structured data (JSON-LD) — pages pass lib/schema.ts builders via the
        `schema` prop. Makes products/FAQs ELIGIBLE for rich results. */}
    {ldJson.map((json) => (
      <script type="application/ld+json" set:html={json} is:inline />
    ))}

    {/* OpenGraph + Twitter — built-in defaults so social shares look right */}
    <meta property="og:title" content={finalTitle} />
    {finalDescription && <meta property="og:description" content={finalDescription} />}
    {siteName && <meta property="og:site_name" content={siteName} />}
    {finalOgImage && <meta property="og:image" content={finalOgImage} />}
    <meta name="twitter:card" content={finalOgImage ? 'summary_large_image' : 'summary'} />

    {favicon && <link rel="icon" href={favicon} />}

    {/* Inter font, swap-loaded so first paint isn't blocked */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />

    {/* Per-tenant brand color CSS variables — server-rendered, no flash on
        first paint. Variables are read by Tailwind v4's @theme directive in
        styles.css and propagate to every brand-* utility class. */}
    {brandStyle && <style set:html={`:root { ${brandStyle} }`} />}

    {/* Meta Pixel — fires PageView on initial load. Per-event firing is
        done client-side in components via lib/pixel.ts. The is:inline tag
        executes inline so the pixel is initialised before user-interaction
        events fire. */}
    {pixelId && (
      <script is:inline define:vars={{ pixelId }}>
        {`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init',pixelId);fbq('track','PageView');`}
      </script>
    )}
  </head>
  <body class="bg-white text-slate-900 overflow-x-hidden">
    <slot />
  </body>
</html>
